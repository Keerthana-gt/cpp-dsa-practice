#include <cassert>
#include "../src/lru_cache.h"

int main() {
    LRUCache cache(2);
    cache.put(1, 10);
    assert(cache.get(1) == 10);
    cache.put(2, 20);
    cache.put(3, 30); // Evicts key 1
    assert(cache.get(1) == -1);
    assert(cache.get(2) == 20 || cache.get(3) == 30);
    return 0;
}
